{
  "name": "svws-e2e-tests",
  "version": "1.0.0",
  "description": "End-to-End tests for SVWS Client using Playwright",
  "scripts": {
    "test": "playwright test --reporter=line",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:keep-data": "KEEP_TEST_DATA=true playwright test --reporter=line",
    "test:keep-data-headed": "KEEP_TEST_DATA=true playwright test --headed",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}